# Keep repository text files consistent across Windows, macOS, and Linux.
* text=auto eol=lf

# Preserve native Windows line endings for command scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never apply text conversion to common binary assets.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
